{
  "name": "@standhigher/shopify-app-kit",
  "version": "0.4.0",
  "description": "Typed React utilities for Shopify embedded app feedback, save flows, navigation, resource picking, and analytics adapters.",
  "license": "MIT",
  "author": "Standhigher",
  "homepage": "https://github.com/standhigher/shopify-app-kit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/standhigher/shopify-app-kit.git",
    "directory": "packages/shopify-app-kit"
  },
  "bugs": {
    "url": "https://github.com/standhigher/shopify-app-kit/issues"
  },
  "keywords": [
    "shopify",
    "shopify-app",
    "shopify-embedded-app",
    "shopify-app-bridge",
    "react",
    "typescript",
    "frontend",
    "components",
    "hooks",
    "ui-kit",
    "feedback",
    "toast",
    "modal",
    "save-bar",
    "dirty-form",
    "navigation",
    "resource-picker",
    "analytics",
    "app-events",
    "polaris",
    "ecommerce",
    "merchant-tools",
    "saas"
  ],
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "docs",
    "examples",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js",
      "require": "./dist/core.cjs"
    },
    "./error": {
      "types": "./dist/error.d.ts",
      "import": "./dist/error.js",
      "require": "./dist/error.cjs"
    },
    "./http": {
      "types": "./dist/http.d.ts",
      "import": "./dist/http.js",
      "require": "./dist/http.cjs"
    },
    "./feedback": {
      "types": "./dist/feedback.d.ts",
      "import": "./dist/feedback.js",
      "require": "./dist/feedback.cjs"
    },
    "./save-flow": {
      "types": "./dist/save-flow.d.ts",
      "import": "./dist/save-flow.js",
      "require": "./dist/save-flow.cjs"
    },
    "./navigation": {
      "types": "./dist/navigation.d.ts",
      "import": "./dist/navigation.js",
      "require": "./dist/navigation.cjs"
    },
    "./resource-picker": {
      "types": "./dist/resource-picker.d.ts",
      "import": "./dist/resource-picker.js",
      "require": "./dist/resource-picker.cjs"
    },
    "./analytics": {
      "types": "./dist/analytics.d.ts",
      "import": "./dist/analytics.js",
      "require": "./dist/analytics.cjs"
    }
  },
  "scripts": {
    "lint": "eslint src --ext .ts,.tsx",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "tsup",
    "build-storybook": "node ./scripts/build-storybook-placeholder.mjs",
    "pack:dry-run": "npm pack --dry-run"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.62.4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@typescript-eslint/eslint-plugin": "^8.24.1",
    "@typescript-eslint/parser": "^8.24.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.20.1",
    "eslint-plugin-react-hooks": "^5.1.0",
    "happy-dom": "^20.11.2",
    "jsdom": "^26.0.0",
    "tsup": "^8.3.6",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.1",
    "vitest": "^3.0.5"
  }
}
