{
  "name": "shopify-app-kit-workspace",
  "private": true,
  "workspaces": [
    "packages/shopify-app-kit"
  ],
  "scripts": {
    "lint": "npm --prefix packages/shopify-app-kit run lint",
    "test": "npm --prefix packages/shopify-app-kit run test",
    "test:coverage": "npm --prefix packages/shopify-app-kit run test:coverage",
    "test:ci": "npm --prefix packages/shopify-app-kit run test -- --reporter=verbose --sequence.concurrent=false --maxWorkers=1",
    "typecheck": "npm --prefix packages/shopify-app-kit run typecheck",
    "build": "npm --prefix packages/shopify-app-kit run build",
    "build-storybook": "npm --prefix packages/shopify-app-kit run build-storybook",
    "pack:dry-run": "cd packages/shopify-app-kit && npm pack --dry-run",
    "login:npm": "npm login --auth-type=web --registry=https://registry.npmjs.org/",
    "publish:pkg": "cd packages/shopify-app-kit && npm publish --access public --registry=https://registry.npmjs.org/"
  }
}
